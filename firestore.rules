rules_version = '2';
// StrataFit · reglas de seguridad de Firestore (T-12). Diseño en docs/tecnica/backend.md.
// · Cada cuenta lee y escribe solo lo suyo (users/{uid} y lo que cuelga de él), con la forma y el tamaño que usa la app
//   (cloud/sync): nada de campos de más, ni documentos con otros nombres, ni de más de 1 MB.
// · El admin (custom claim role: 'admin', que solo se pone desde GitHub Actions: tools/admin) lee además los perfiles de
//   todas las cuentas y las contraseñas temporales (adminInbox), y borra estas al entregarlas. Nunca ve los entrenos, las
//   comidas, las medidas ni la foto de nadie.
// · Solo valen cuentas con correo técnico (usuario@stratafit.app): una cuenta creada a mano con otro correo no entra en nada.
// · Lo que no está aquí (informes: M5) está denegado.
// Se prueban con el emulador de Firebase (tests/rules.test.mjs) y se despliegan desde GitHub Actions al fusionar en main.
service cloud.firestore {
  match /databases/{database}/documents {
    function techUser() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email.matches('^[a-z0-9._-]{3,20}@stratafit[.]app$');
    }
    function isOwner(uid) {
      return techUser() && request.auth.uid == uid;
    }
    function isAdmin() {
      return techUser() && request.auth.token.get('role', '') == 'admin';
    }
    // preferencias del perfil: tema, color, estilo Cristal, unidades, sonido y avisos
    function validPrefs(p) {
      return p is map && p.keys().hasOnly(['theme', 'acc', 'gm', 'gl', 'gk', 'un', 'snd', 'snt', 'vol', 'vib', 'awk', 'notif']);
    }
    function validProfile(d) {
      return (!('sx' in d) || d.sx in ['M', 'F', '']) && (!('pr' in d) || validPrefs(d.pr))
        && (!('m' in d) || d.m is int) && (!('ca' in d) || d.ca is int) && (!('mc' in d) || d.mc is bool);
    }
    // una parte del estado: su contenido en texto JSON (j), cuándo y desde qué dispositivo se escribió, y su versión
    function validPart(d, max) {
      return d.keys().hasOnly(['j', 'm', 'r', 'v', 'd']) && d.j is string && d.j.size() <= max && d.m is int
        && d.r is string && d.r.size() <= 24 && d.v is int && d.d is string && d.d.size() <= 24;
    }
    // el índice: la versión de cada parte
    function validIndex(d) {
      return d.keys().hasOnly(['p', 'm', 'd']) && d.p is map && d.p.size() <= 2000 && d.m is int && d.d is string && d.d.size() <= 24;
    }
    function writesPart(uid, max) {
      return isOwner(uid) && (request.method == 'delete' || validPart(request.resource.data, max));
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // al registrarse: el usuario tiene que ser el del correo técnico de la cuenta
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['u', 'sx', 'pr', 'ca', 'm'])
        && request.resource.data.u is string && request.resource.data.u.lower() + '@stratafit.app' == request.auth.token.email
        && validProfile(request.resource.data);
      // después: sexo y preferencias; «debe cambiar la contraseña» (mc) solo se puede quitar (lo pone GitHub Actions)
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sx', 'pr', 'm', 'mc'])
        && validProfile(request.resource.data)
        && (!('mc' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.mc == false);
      allow delete: if false;

      match /data/{doc} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (request.method == 'delete'
          || doc == 'index' && validIndex(request.resource.data)
          || doc == 'core' && validPart(request.resource.data, 1000000));
      }
      match /logs/{year} {
        allow read: if isOwner(uid);
        allow write: if year.matches('^([0-9]{4}|otros)$') && writesPart(uid, 1000000);
      }
      match /hist/{year} {
        allow read: if isOwner(uid);
        allow write: if year.matches('^([0-9]{4}|otros)$') && writesPart(uid, 1000000);
      }
      match /meals/{month} {
        allow read: if isOwner(uid);
        allow write: if month.matches('^([0-9]{4}-[0-9]{2}|otros)$') && writesPart(uid, 1000000);
      }
      // la foto de perfil, solo con consentimiento (lo pide la app) y de 150 KB como mucho
      match /private/{doc} {
        allow read: if isOwner(uid);
        allow write: if doc == 'avatar' && writesPart(uid, 150000);
      }
    }

    // contraseñas temporales: las crea GitHub Actions (con la cuenta de servicio, que no pasa por estas reglas)
    match /adminInbox/{id} {
      allow read, delete: if isAdmin();
    }
  }
}
